*** Settings ***
Documentation    Robot para comprobar disponibilidad y solicitar préstamo de prensa en eBiblio Madrid.
Library          Browser

*** Variables ***
${URL_LOGIN}        https://madrid.ebiblio.es/
${URL_PERIODICO}    https://madrid.ebiblio.es/opac/#ficha_del_periodico_deseado
${USUARIO}          TU_USUARIO_O_CARNET
${PASSWORD}         TU_CONTRASEÑA

*** Test Cases ***
Prestar Periodico Del Dia
    # Abrir navegador en modo segundo plano (headless)
    New Browser    browser=chromium    headless=True
    New Page       ${URL_LOGIN}

    # 1. Iniciar sesión
    Click          text="Iniciar sesión"
    Fill Text      input[name="username"]    ${USUARIO}
    Fill Text      input[name="password"]    ${PASSWORD}
    Click          button:has-text("Entrar")

    # Esperar a que el login procese la sesión
    Wait For Elements State    text="Mi cuenta"    visible    timeout=10s

    # 2. Navegar a la ficha del periódico
    Go To          ${URL_PERIODICO}

    # 3. Verificar disponibilidad del botón de préstamo
    ${is_available}=    Run Keyword And Return Status    
    ...                 Wait For Elements State    button:has-text("Prestar")    visible    timeout=5s

    IF    ${is_available}
        Click    button:has-text("Prestar")
        Log      ¡Préstamo realizado con éxito!    console=True
    ELSE
        Log      El periódico aún no está disponible o las licencias están agotadas.    console=True
    END

    Close Browser
